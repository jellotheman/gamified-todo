{
  "name": "gamified-todo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "functions"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run start --workspace apps/mobile",
    "android": "npm run android --workspace apps/mobile",
    "ios": "npm run ios --workspace apps/mobile",
    "web": "npm run web --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace apps/mobile",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:functions",
    "build:functions": "npm run build --workspace functions",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-gamified-todo --only auth,firestore,functions",
    "test:integration": "npm run build:functions && firebase emulators:exec --project demo-gamified-todo --only auth,firestore,functions \"npm run test:integration --workspace functions\"",
    "start:cloud": "npm run start:cloud --workspace apps/mobile",
    "setup": "node scripts/setup-cloud.mjs",
    "promote": "node scripts/promote.mjs"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "firebase-tools": "^15.33.0",
    "react": "19.2.3",
    "typescript-eslint": "^8.71.1"
  }
}
