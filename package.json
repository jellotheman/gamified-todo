{
  "name": "gamified-todo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run start --workspace apps/mobile",
    "android": "npm run android --workspace apps/mobile",
    "ios": "npm run ios --workspace apps/mobile",
    "web": "npm run web --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace apps/mobile",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "firebase-tools": "^15.33.0",
    "react": "19.2.3"
  }
}
