{
  "name": "gamified-todo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "functions"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run start --workspace apps/mobile",
    "android": "npm run android --workspace apps/mobile",
    "ios": "npm run ios --workspace apps/mobile",
    "web": "npm run web --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspace apps/mobile",
    "lint": "npm run lint --workspace apps/mobile"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
