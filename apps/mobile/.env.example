# Copy to .env.local after the Firebase development web app is registered.
# Public Firebase client identifiers are bundled in the app, never server secrets.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=gamified-todo-dev-jellotheman.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=gamified-todo-dev-jellotheman
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional logs-only storage/service initialization check.
# EXPO_PUBLIC_RUN_DEVELOPMENT_SMOKE=true
# Optional emulator tests only: explicitly set USE_FIREBASE_EMULATORS=true.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
