# Optional: default startup already uses the local demo project; no account needed.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# Optional storage and Firebase service-wiring check (logs only; no network).
# EXPO_PUBLIC_RUN_DEVELOPMENT_SMOKE=true
# Android emulator defaults to 10.0.2.2; web/iOS simulator default to 127.0.0.1.
# For a physical phone, set this to the development computer's LAN IP.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10

# Cloud mode requires explicitly setting the flag to false and ALL four values.
# These are public Firebase client identifiers, never Admin/service-account secrets.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
