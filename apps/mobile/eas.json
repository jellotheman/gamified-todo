{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "development", "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "false" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "development", "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "false" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production", "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "false" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
